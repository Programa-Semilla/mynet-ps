# pnpm is the only supported package manager (research.md D2).
# Strict hoisting keeps phantom dependencies out, which is what makes FR-003
# ("every dependency justified") enforceable rather than aspirational.
shamefully-hoist=false
strict-peer-dependencies=false
auto-install-peers=true

# Reproducible installs. FR-002 requires a clean clone to resolve an identical
# dependency set; a lockfile that CI is allowed to rewrite is not a lockfile.
prefer-frozen-lockfile=true
