# Secrets and per-environment configuration for the compose stack. Copy to `.env` ON THE VM and
# fill it in. **NEVER COMMITTED, NEVER RSYNCED** — `deploy.sh` excludes it explicitly, because a
# sync with `--delete` would otherwise destroy it on every deploy.
#
# Generate the two auth secrets with:  openssl rand -base64 48

# ── The public address ────────────────────────────────────────────────────────────────────────
# Must match the A record pointing at this VM. Caddy uses it for the certificate (FR-479) and the
# API uses it as WEB_ORIGIN.
APP_DOMAIN=
# Where Let's Encrypt sends expiry warnings. A real, monitored mailbox.
ACME_EMAIL=

# ── The database ──────────────────────────────────────────────────────────────────────────────
# `postgres` is the compose service name on this VM's own private network — see
# deploy/vm/envs/*.env for why DATABASE_HOST is compared rather than assumed (FR-485).
DATABASE_HOST=postgres
# **Must differ between UAT and production.** `_common.sh` refuses to run any UAT script when
# these collide, because 001's FR-067 requires the tooling to refuse rather than merely to be
# configured correctly.
DATABASE_NAME=
POSTGRES_USER=mynet
POSTGRES_PASSWORD=

# ── Authentication ────────────────────────────────────────────────────────────────────────────
# **Different values per environment, and never reused.** The pepper is mixed into every stored
# password hash: sharing it between UAT and production would mean a UAT database disclosure was a
# production one.
AUTH_PASSWORD_PEPPER=
AUTH_ATTEMPT_HASH_KEY=
AUTH_SESSION_IDLE_DAYS=14

# ── Transactional account mail ────────────────────────────────────────────────────────────────
# Register entry 18 is open: no provider has been chosen. Left blank, the API keeps its
# development sink — verification and reset links are written to a log and never sent. That is
# usable for UAT and is NOT acceptable for production, where an attendee who cannot verify an
# address never becomes discoverable at all (FR-325).
MAIL_FROM=
MAIL_SMTP_URL=

# ── Avatars ───────────────────────────────────────────────────────────────────────────────────
# Both renditions come from one decode through `images/avatar.ts` (FR-458). Raising the card
# dimension raises the size of every directory response, since the card rendition is embedded.
AVATAR_DIMENSION_PX=512
AVATAR_CARD_DIMENSION_PX=96

# ── Backups (FR-487) ──────────────────────────────────────────────────────────────────────────
# Where `backup.sh` writes dumps on this machine, and how many it keeps.
BACKUP_DIR=/home/azureuser/app/deploy/vm/backups
BACKUP_KEEP_LOCAL=7
# Refuse to run when free space is below this, rather than filling the disk the live database
# writes to. A backup that stops PostgreSQL from writing is worse than a missing backup.
BACKUP_MIN_FREE_MB=2048
