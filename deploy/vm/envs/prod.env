# Non-secret infra config for the Production environment. Committed. Sourced by _common.sh.
#
# NOTHING SECRET GOES IN THIS FILE — see envs/uat.env for the reasoning and for what the two
# blank values below are waiting on (owner decisions, tasks T004 and T006).
SUBSCRIPTION=
RESOURCE_GROUP=rg-mynet-prod
VM_NAME=vm-mynet-prod
LOCATION=centralus
VM_SIZE=Standard_B2s
ADMIN_USER=azureuser

# No domain registered yet. Caddy cannot issue a certificate without a resolving A record
# (FR-479), so this gates the first production deploy.
APP_DOMAIN=

# ═════════════════════════════════════════════════════════════════════════════════════════════
# **THE FR-485 GUARD READS THESE TWO.** `_common.sh` refuses every `uat` script when UAT's
# resolved database host matches this one. Production is a separate VM with its own loopback-only
# PostgreSQL container, so the two are distinct by construction today — the guard is what makes a
# *future* change that pointed UAT at this database fail loudly rather than work.
#
# The database NAME differs as well as the host. That is belt and braces on purpose: it means a
# connection string copied between environments by hand fails to connect rather than connecting
# to the wrong data.
# ═════════════════════════════════════════════════════════════════════════════════════════════
DATABASE_HOST=postgres
DATABASE_NAME=mynet_prod
