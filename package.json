{
  "name": "mynet",
  "version": "0.0.0",
  "private": true,
  "description": "MyNet — multi-event attendee engagement and professional networking platform",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "start": "node scripts/local-up.mjs",
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @mynet/api dev",
    "dev:web": "pnpm --filter @mynet/web dev",
    "dev:admin": "pnpm --filter @mynet/admin dev",
    "build": "pnpm --filter @mynet/api build && pnpm --filter @mynet/web build && pnpm --filter @mynet/admin build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test e2e/accessibility.spec.ts e2e/admin-accessibility.spec.ts",
    "contract:generate": "pnpm --filter @mynet/api contract:generate && pnpm --filter @mynet/data types:generate",
    "contract:check": "pnpm --filter @mynet/api contract:check && pnpm --filter @mynet/data types:check",
    "db:migrate": "pnpm --filter @mynet/api db:migrate",
    "db:seed": "pnpm --filter @mynet/api db:seed",
    "db:generate": "pnpm --filter @mynet/api db:generate",
    "admin:bootstrap": "pnpm --filter @mynet/api admin:bootstrap",
    "budget": "node scripts/asset-budget.mjs",
    "brand:audit": "node scripts/brand-audit.mjs",
    "brand:generate": "pnpm brand:generate:board && pnpm brand:generate:install",
    "brand:generate:board": "node scripts/generate-brand-assets.mjs",
    "brand:generate:install": "node scripts/generate-install-icons.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:unit && pnpm test:component && pnpm contract:check && pnpm test:integration && pnpm build && pnpm budget && pnpm brand:audit && pnpm test:e2e",
    "verify:clean": "node scripts/verify-clean.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.8.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
