{
  "openapi": "3.1.0",
  "info": {
    "title": "MyNet API",
    "description": "Project-owned API for the MyNet attendee workspace. Every endpoint except sign-in requires a valid sign-in session cookie, and every authenticated endpoint resolves the attendee from that cookie server-side — never from a client-supplied identifier (FR-035, FR-036).",
    "version": "0.1.0"
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "mynet_session",
        "description": "Opaque sign-in session token. HttpOnly, Secure, SameSite=Lax. Never appears in a response body."
      }
    },
    "schemas": {}
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness probe",
        "tags": [
          "operational"
        ],
        "description": "Reports that the process is running. Does not check dependencies.",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/sign-in": {
      "post": {
        "summary": "Exchange credentials for a sign-in session cookie",
        "tags": [
          "auth"
        ],
        "description": "On success, sets an HttpOnly, Secure, SameSite=Lax cookie. The token never appears in the response body. Every failure — unknown identifier, wrong credential — returns one identical refusal (FR-030).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "additionalProperties": false,
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 320
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Signed in. The session is in the cookie."
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "fields": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "One identical refusal for every cause (FR-030).",
            "content": {
              "application/json": {
                "schema": {
                  "description": "One identical refusal for every cause (FR-030).",
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Throttled. Reveals nothing about whether the identifier exists (FR-031d).",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Throttled. Reveals nothing about whether the identifier exists (FR-031d).",
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "retryAfterSeconds": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/sign-out": {
      "post": {
        "summary": "Revoke the current sign-in session server-side",
        "tags": [
          "auth"
        ],
        "description": "Sets revoked_at on this device's session row and clears the cookie. Other devices are unaffected (FR-027, FR-029).",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "204": {
            "description": "Signed out."
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "The signed-in attendee's identity",
        "tags": [
          "auth"
        ],
        "description": "Resolved from the sign-in session cookie server-side. Takes no attendee identifier and has no way to return another attendee (FR-032, FR-035, FR-036).",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "email",
                    "displayName"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "email": {
                      "type": "string"
                    },
                    "displayName": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Distinguishes an expired session from never having signed in, so the client can explain inactivity (FR-028c).",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Distinguishes an expired session from never having signed in, so the client can explain inactivity (FR-028c).",
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/events": {
      "get": {
        "summary": "Events the signed-in attendee is registered for",
        "tags": [
          "workspace"
        ],
        "description": "Scoped through registrations for the authenticated attendee. There is no attendee_id parameter, on purpose. An attendee registered for no events receives an empty collection, not an error (FR-040).",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "name",
                      "location",
                      "startsOn",
                      "endsOn",
                      "timezone"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "name": {
                        "type": "string"
                      },
                      "location": {
                        "type": "string"
                      },
                      "startsOn": {
                        "type": "string"
                      },
                      "endsOn": {
                        "type": "string"
                      },
                      "timezone": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/workspace/active-event": {
      "get": {
        "summary": "The attendee's active conference, recorded or derived",
        "tags": [
          "workspace"
        ],
        "description": "Returns the attendee's explicitly chosen conference, or — while they have never chosen — the one derived from their registrations: in progress at the venue today, else next to start, else most recently ended (FR-102, FR-103). An attendee registered for no conferences receives 204 with no body, which is a valid answer and not an error (FR-105). Carries the venue timezone so the client can compute \"day N of M\" itself; that counter is never stored and never sent (FR-121).",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "name",
                    "location",
                    "startsOn",
                    "endsOn",
                    "timezone"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "name": {
                      "type": "string"
                    },
                    "location": {
                      "type": "string"
                    },
                    "startsOn": {
                      "type": "string"
                    },
                    "endsOn": {
                      "type": "string"
                    },
                    "timezone": {
                      "type": "string",
                      "description": "IANA zone of the venue, e.g. Europe/Madrid (FR-120)."
                    }
                  }
                }
              }
            }
          },
          "204": {
            "description": "Registered for no conferences (FR-105). An empty body, not an error and not a fabricated event — the client renders an explicit empty state."
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Record the attendee's chosen conference",
        "tags": [
          "workspace"
        ],
        "description": "Records an explicit choice, which is then honoured indefinitely — it is never re-derived when the chosen conference ends (FR-104). Idempotent: selecting the already-active conference succeeds and changes nothing observable. Refuses a conference the attendee is not registered for identically to one that does not exist (FR-148).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "eventId"
                ],
                "additionalProperties": false,
                "properties": {
                  "eventId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "The newly active conference, echoed in full so the client can reconcile a concurrent switch without a second request (research D9).",
            "content": {
              "application/json": {
                "schema": {
                  "description": "The newly active conference, echoed in full so the client can reconcile a concurrent switch without a second request (research D9).",
                  "type": "object",
                  "required": [
                    "id",
                    "name",
                    "location",
                    "startsOn",
                    "endsOn",
                    "timezone"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "name": {
                      "type": "string"
                    },
                    "location": {
                      "type": "string"
                    },
                    "startsOn": {
                      "type": "string"
                    },
                    "endsOn": {
                      "type": "string"
                    },
                    "timezone": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not registered for that conference, **or** no such conference. Deliberately indistinguishable (FR-148).",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Not registered for that conference, **or** no such conference. Deliberately indistinguishable (FR-148).",
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/events/{eventId}/sessions": {
      "get": {
        "summary": "The conference's programme, chronological",
        "tags": [
          "catalog"
        ],
        "description": "Every session for the named conference in start order, each with its track, its room and its speakers. An event with no programme returns an empty array — a valid answer, not a failure (FR-139). Times are absolute instants; no relative wording is sent, because \"starts in 15 minutes\" is only true at the moment it is computed (FR-124).",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "eventId",
            "required": true
          }
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "title",
                      "summary",
                      "startsAt",
                      "endsAt",
                      "track",
                      "room",
                      "speakers"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "title": {
                        "type": "string"
                      },
                      "summary": {
                        "type": [
                          "null",
                          "string"
                        ]
                      },
                      "startsAt": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "endsAt": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "track": {
                        "type": "object",
                        "required": [
                          "id",
                          "name",
                          "colorToken"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "name": {
                            "type": "string"
                          },
                          "colorToken": {
                            "type": "string",
                            "description": "A theme token NAME, e.g. track-design. Never a colour value — the palette lives in the client theme and nowhere else (FR-136)."
                          }
                        }
                      },
                      "room": {
                        "type": "object",
                        "required": [
                          "id",
                          "name"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "name": {
                            "type": "string"
                          }
                        }
                      },
                      "speakers": {
                        "type": "array",
                        "description": "Empty when the session has none (FR-138). An empty list rather than null, so a client cannot confuse \"no speaker\" with \"not loaded\".",
                        "items": {
                          "type": "object",
                          "required": [
                            "id",
                            "name",
                            "title",
                            "company"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "id": {
                              "type": "string",
                              "format": "uuid"
                            },
                            "name": {
                              "type": "string"
                            },
                            "title": {
                              "type": [
                                "null",
                                "string"
                              ]
                            },
                            "company": {
                              "type": [
                                "null",
                                "string"
                              ]
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not registered for that conference, **or** no such conference. The two are deliberately indistinguishable — identical status and identical body — so that an attendee cannot enumerate conferences by watching which refusal comes back (FR-148).",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Not registered for that conference, **or** no such conference. The two are deliberately indistinguishable — identical status and identical body — so that an attendee cannot enumerate conferences by watching which refusal comes back (FR-148).",
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/events/{eventId}/tracks": {
      "get": {
        "summary": "The conference's tracks, for coding and legends",
        "tags": [
          "catalog"
        ],
        "description": "Each track with its name and its theme token name. Never a colour value (FR-136, research D7). The name is what makes colour never the sole carrier of meaning — a track is always rendered in text as well.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "eventId",
            "required": true
          }
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "name",
                      "colorToken"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "name": {
                        "type": "string"
                      },
                      "colorToken": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not registered for that conference, **or** no such conference. The two are deliberately indistinguishable — identical status and identical body — so that an attendee cannot enumerate conferences by watching which refusal comes back (FR-148).",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Not registered for that conference, **or** no such conference. The two are deliberately indistinguishable — identical status and identical body — so that an attendee cannot enumerate conferences by watching which refusal comes back (FR-148).",
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "auth",
      "description": "Sign-in session lifecycle"
    },
    {
      "name": "workspace",
      "description": "The signed-in attendee's own data"
    },
    {
      "name": "operational",
      "description": "Liveness for the hosting platform"
    }
  ]
}
