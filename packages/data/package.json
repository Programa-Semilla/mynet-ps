{
  "name": "@mynet/data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Repository interfaces in domain terms, and the only place the client constructs requests (constitution Principle V)",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./http": "./src/http/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "types:generate": "openapi-typescript ../../contracts/openapi.json -o src/generated/api.ts",
    "types:check": "openapi-typescript ../../contracts/openapi.json -o /tmp/mynet-api-types.ts && diff -q /tmp/mynet-api-types.ts src/generated/api.ts"
  },
  "devDependencies": {
    "@mynet/config": "workspace:*",
    "openapi-typescript": "^7.13.0",
    "typescript": "6.0.3"
  }
}
