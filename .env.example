# MyNet — local environment template (T009)
#
# Copy to `.env` and fill in your own values:  cp .env.example .env
#
# `.env` is git-ignored and MUST stay that way. FR-041: secrets never appear in the client
# bundle, the repository, or preview deployments.
#
# ────────────────────────────────────────────────────────────────────────────────────────
# FR-007 — every value below points at a throwaway database. Local development MUST NOT
# require access to any store holding real attendee data. If you find yourself pasting a
# production connection string here, stop: that is the defect, not an inconvenience.
# ────────────────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────────────────
# A personal Neon branch, or local PostgreSQL. Never a shared or production database.
# Local via Docker:
#   docker run --name mynet-pg -e POSTGRES_PASSWORD=mynet -e POSTGRES_USER=mynet \
#     -e POSTGRES_DB=mynet_dev -p 5432:5432 -d postgres:17
DATABASE_URL=postgresql://mynet:mynet@localhost:5432/mynet_dev

# ── Authentication ──────────────────────────────────────────────────────────────────────
# Pepper applied to password hashing in addition to Argon2id's per-hash salt (research.md D8).
# Generate your own:  openssl rand -base64 48
# Changing this value invalidates every existing password hash — it is not rotatable in place.
AUTH_PASSWORD_PEPPER=replace-me-with-openssl-rand-base64-48

# Key for the keyed hashes in `sign_in_attempts` (data-model.md). Lets the table count attempts
# per identifier while holding no readable email address (FR-031c, FR-042).
# Generate your own:  openssl rand -base64 48
AUTH_ATTEMPT_HASH_KEY=replace-me-with-openssl-rand-base64-48

# Sign-in session idle window, sliding on each authenticated request (FR-028a, research.md D17).
# 14 days in production. quickstart.md Scenario 6 asks you to shorten this locally to test
# expiry without idling for a fortnight.
AUTH_SESSION_IDLE_DAYS=14

# ── Account links (004) ─────────────────────────────────────────────────────────────────
# SAFE DEVELOPMENT DEFAULTS — both may be omitted entirely and the API boots.
#
# How long a verification link stays usable (FR-320). Followed at leisure, so it is generous.
AUTH_VERIFICATION_LIFETIME_HOURS=24

# How long a password-reset link stays usable (FR-328). Deliberately much shorter: possession
# of this link is possession of the account. Open Question 7 records both as assumptions.
AUTH_RESET_LIFETIME_MINUTES=60

# How long `POST /auth/reset-request` takes, whether or not the address has an account (FR-327).
# An identical status and body are not an identical response if one branch is measurably faster,
# and issuing a token plus sending mail is. The API REFUSES TO START in production below 400ms.
# Lower it only in a test environment, where nothing measures elapsed time.
AUTH_RESET_BRANCH_BUDGET_MS=600

# ── Deployment topology ─────────────────────────────────────────────────────────────────
# How many reverse proxies sit in front of this service. THIS IS A SECURITY SETTING, not a
# performance one: it decides which entry in `X-Forwarded-For` becomes `request.ip`, and
# `request.ip` is the source dimension every throttle counter bounds an attacker by.
#
# Set it too high — or leave 1 when the service is reached directly — and a client can write
# the header itself, occupy a different source on every request, and the source allowance that
# is the only real bound on reset-request flooding never binds at all.
#
# 1 is correct for a single edge (one Fly.io proxy). Set 0 when nothing fronts the service.
TRUSTED_PROXY_HOPS=1

# ── Avatars (004) ───────────────────────────────────────────────────────────────────────
# SAFE DEVELOPMENT DEFAULTS — both may be omitted.
#
# Refused before any bytes are stored (FR-347). 5 MiB.
AVATAR_MAX_UPLOAD_BYTES=5242880

# The bounded square every accepted image is resized to (FR-348). One size, not a set.
AVATAR_DIMENSION_PX=512
#
# The accepted image formats are deliberately NOT configurable — see `config.ts`. They are a
# security boundary rather than a preference, and widening one by editing a deployment is not
# a change anybody would review.

# ── Transactional account mail (004) ────────────────────────────────────────────────────
# SAFE DEVELOPMENT DEFAULT — the development adapter writes to a sink and sends nothing, so
# this value is unused locally and the API boots without it.
#
# NO SAFE PRODUCTION DEFAULT. Verification and password recovery cannot work in a deployed
# environment until a transactional mail provider is chosen and provisioned — register entry
# 18, and the one open dependency capable of making a shipped surface non-functional. Only
# account mail is in scope (FR-395); engagement notifications remain excluded.
MAIL_FROM=MyNet <no-reply@mynet.invalid>

# ── API ─────────────────────────────────────────────────────────────────────────────────
API_PORT=3000
API_HOST=0.0.0.0

# Origin allowed to send credentialed requests to the API. The sign-in cookie is
# SameSite=Lax, so client and API must be same-site in production.
WEB_ORIGIN=http://localhost:5173

# `production` enables Secure cookies. Leave unset locally, where there is no TLS.
NODE_ENV=development

# ── Client ──────────────────────────────────────────────────────────────────────────────
# Only VITE_-prefixed values reach the browser bundle. Nothing secret may ever carry this
# prefix — that is the whole mechanism keeping FR-041 true on the client side.
VITE_API_BASE_URL=http://localhost:3000
